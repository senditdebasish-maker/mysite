# ══════════════════════════════════════════════════════════
# Debasish Das store — XAMPP Apache + PHP config
# Order matters: hard blocks → redirects → dynamic PHP endpoints.
# ══════════════════════════════════════════════════════════
<IfModule mod_rewrite.c>
  RewriteEngine On

  # ── 1. never serve sensitive paths ──
  RewriteRule ^(data|vendor|\.git|\.github)(/|$) - [R=404,L]
  RewriteRule ^(?:\.|composer(\.json|\.lock|\.zip)|README\.md)$ - [R=404,L]
  RewriteRule ^api/(core|lib|seed)\.php$ - [R=404,L]
  RewriteRule ^tests(/|$) - [R=404,L]

  # ── 2. /index[.html] → same page handler (no external redirect: an explicit
  #       ./ substitution leaks the filesystem path on Windows/XAMPP subfolders) ──
  RewriteRule ^index/?$ page.php?page=index.html [L,QSA]

  # ── 3. dynamic endpoints ──
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteRule ^product/([A-Za-z0-9_-]{1,32})/?$ product.php?id=$1 [L,QSA]
  RewriteRule ^sitemap\.xml$ api/misc.php?what=sitemap [L,QSA]
  RewriteRule ^robots\.txt$ api/misc.php?what=robots [L,QSA]
  # api/index.php itself matches ^api(...) — without the !-f guard Apache re-applies
  # the rule to the rewritten URL forever (internal-redirect loop → 500 on every /api call)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^api(/.*)?$ api/index.php?r=$1 [L,QSA]
  RewriteRule ^assets/js/([\w.-]+\.js)$ js.php?file=$1 [L,QSA]

  # ── 4. HTML pages (substitution + setup gate) ──
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteRule ^([\w.-]+\.html)$ page.php?page=$1 [L,QSA]
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteRule ^$ page.php [L,QSA]
</IfModule>

# ── caching for real static assets ──
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|jpe?g|png|svg|woff2?|ico|gif|webp|avif)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

ErrorDocument 404 /404.html
